+}
+
+// Poke the consumer's eventfd once per present. Runs on cs2's present/render
+// thread, so it MUST never block: the fd is EFD_NONBLOCK and the counter
+// coalesces, so a slow consumer can never back-pressure the render. Errors are
+// swallowed (the next present re-pokes).
+void capture_signal_present()
+{
+    if (data.present_eventfd < 0) {
+        return;
+    }
+    const uint64_t one = 1;
+    ssize_t r = write(data.present_eventfd, &one, sizeof(one));
+    (void)r;
+}
+
+// Frame pacing for the consumer that asked for it (pace_fps > 0): hold each present
+// until the next slot of an absolute 1/pace_fps grid, so the game presents at exactly
+// pace_fps instead of its own limiter's ~5% overshoot. A late frame (render spike)
+// goes out immediately and the following frames run unthrottled until the grid is
+// caught up again; only when it falls more than PACE_MAX_BEHIND_NS behind does the
+// grid restart from now. Runs on the present thread, before the real present.
+#define PACE_MAX_BEHIND_NS 250000000LL
+static int64_t pace_now_ns(void)
+{
+    // CLOCK_MONOTONIC, the clock clock_nanosleep waits on (os_time_get_nano is RAW).
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+void capture_pace_present()
+{
+    if (data.pace_fps <= 0 || !data.capturing) {
+        data.pace_next = 0;
+        return;
+    }
+    const int64_t interval = 1000000000LL / data.pace_fps;
+    const int64_t now = pace_now_ns();
+    if (data.pace_next == 0 || now - data.pace_next > PACE_MAX_BEHIND_NS) {
+        data.pace_next = now + interval;
+        return;
+    }
+    if (now < data.pace_next) {
+        struct timespec ts = {
+            .tv_sec = data.pace_next / 1000000000LL,
+            .tv_nsec = data.pace_next % 1000000000LL,
+        };
+        while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL) == EINTR) {
+        }
     }
+    data.pace_next += interval;
 }
 
