@@ -149,6 +161,22 @@ void capture_update_socket()
             || old_map_host != data.map_host)) {
             data.need_reinit = true;
         }
+        // The consumer may hand us an eventfd (SCM_RIGHTS) to poke on every
+        // present; only when it asked via want_present_signal.
+        if (control.want_present_signal) {
+            for (struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg); cmsg;
+                    cmsg = CMSG_NXTHDR(&msg, cmsg)) {
+                if (cmsg->cmsg_level == SOL_SOCKET && cmsg->cmsg_type == SCM_RIGHTS) {
+                    int fd = -1;
+                    memcpy(&fd, CMSG_DATA(cmsg), sizeof(int));
+                    if (data.present_eventfd >= 0) {
+                        close(data.present_eventfd);
+                    }
+                    data.present_eventfd = fd;
+                    break;
+                }
+            }
+        }
     }
     if (n == -1) {
         if (errno == EAGAIN || errno == EWOULDBLOCK) {
@@ -162,7 +190,25 @@ void capture_update_socket()
         close(data.connfd);
         data.connfd = -1;
         data.accepted = false;
+        if (data.present_eventfd >= 0) {
+            close(data.present_eventfd);
+            data.present_eventfd = -1;
+        }
+    }
+}
+
+// Poke the consumer's eventfd once per present. Runs on cs2's present/render
+// thread, so it MUST never block: the fd is EFD_NONBLOCK and the counter
+// coalesces, so a slow consumer can never back-pressure the render. Errors are
+// swallowed (the next present re-pokes).
+void capture_signal_present()
+{
+    if (data.present_eventfd < 0) {
+        return;
     }
+    const uint64_t one = 1;
+    ssize_t r = write(data.present_eventfd, &one, sizeof(one));
+    (void)r;
 }
 
