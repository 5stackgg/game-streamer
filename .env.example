# Copy to src/.env and fill in. Loaded automatically by game-streamer.sh.

# --- flow 1: setup-steam ---------------------------------------------------
export STEAM_USER=cs2_servers
export STEAM_PASSWORD=

# --- flow 2: run-live ------------------------------------------------------
export MATCH_ID=

# Pick ONE of these two pairs:
# export PLAYCAST_URL=
# - or -
export CONNECT_ADDR=
export CONNECT_PASSWORD=

# --- optional overrides ----------------------------------------------------
# export DEBUG_STREAM_ID=debug
# export FPS=30
# CS2_FPS_MAX: clip batches default to 2x the clip rate (1x only with both CLIP_PACE=0 and CLIP_FIXED_TIMESTEP=0), demo streaming to 120 — see the render cap note below.
# export VIDEO_KBPS=6000
# SRT buffer in ms. By default it is 4x the measured round trip to MediaMTX,
# never under 120 (the lowest MediaMTX accepts). Set it to override.
# export SRT_LATENCY_MS=300
# --- Per-node auto-tune (cs2_autotune in src/lib/cs2-tune.sh) --------------
# On launch the node's GPU class + CPU core count are detected and the knobs
# below are filled in per node. Anything you export here ALWAYS wins.
#
# GPU scale+convert: when the NVENC encoder is CUDA-based, the capture
# scale (e.g. 1440p->1080p) and RGB->NV12 convert run on the GPU
# (cudaconvertscale) instead of the CPU, freeing cores for cs2. Auto-tune
# sets 'auto' on modern GPUs and '0' (CPU) on weak Maxwell-class cards.
# On AMD the VA-API encoder gets vapostproc for the scale and convert instead
# ('auto' means vapostproc there); 0 keeps them on the CPU.
# export GS_GPU_SCALE=0
#
# cs2 worker threads. Left to the engine by default (we never pass -threads) —
# auto-detect is Valve's recommendation and a high explicit -threads is a known
# cs2 stutter source. Escape hatch only: set CS2_THREADS=N to force -threads N on
# a misbehaving node.
# export CS2_THREADS=6
#
# The GPU clock lock below is NVIDIA only: AMD pods never write GPU clocks or
# power levels.
#
# GPU clock lock (lock_gpu_clocks in cs2-tune.sh): pins the GPU graphics clock
# so it doesn't downclock at low utilisation and then oscillate ramping back up
# under bursty load — that P-state oscillation reads as intermittent stutter
# even at <50% GPU use. Headless equivalent of PowerMizer "Prefer Maximum
# Performance" (nvidia-smi -pm 1 + -lgc). On by default; set 0 to disable, or
# pin a specific MHz (defaults to the card's max).
# export GS_GPU_LOCK_CLOCKS=0
# export GS_GPU_LOCK_MHZ=2400
#
# --- Clip capture method (the gunfight-stutter fix) -------------------------
# PROVEN cause of the clip stutter: ximagesrc's X11 XShmGetImage grab serializes
# with cs2's frame-present on the single-threaded X server, so at heavy moments
# cs2's render BLOCKS waiting on it (DIAG showed gpu util -> 0%, cs2 idle, 9fps).
# The fix is to capture frames where they already live — inside cs2's Vulkan
# present — so capture can never contend with the render on the X server.
#
# CLIP_CAPTURE_METHOD=vkcapture (DEFAULT): the obs-vkcapture Vulkan LAYER, loaded
# into cs2 via the OBS_VKCAPTURE=1 launch option (set by set_cs2_launch_options),
# hooks vkQueuePresentKHR and shares the swapchain image over a unix socket. Our
# vkcapture-consumer (built into the image) binds that socket and feeds frames
# into the SAME NVENC pipeline as before. No X server involvement => no stall.
#   HOST PREREQUISITE: nvidia-drm.modeset=1 on the host kernel cmdline (a SUPPORTED
#   NVIDIA setting — needed for DRM/dmabuf — NOT a binary driver patch). Verify:
#     cat /sys/module/nvidia_drm/parameters/modeset      # want: Y
#   If N: add `nvidia-drm.modeset=1` to GRUB_CMDLINE_LINUX, update-grub, reboot.
#   AMD: no such prerequisite. The layer hands frames to the consumer through the
#   host-map copy (no CUDA import), which needs no nvidia-drm setting.
#   On-node debug: `VKCAP_TEST=1 vkcapture-consumer` logs the layer's frame
#   geometry (fourcc/modifier/nfd) and dumps one frame — run it (with cs2 up under
#   OBS_VKCAPTURE=1) to confirm the present-hook link before chasing the encode.
#
# CLIP_CAPTURE_METHOD=ximagesrc: the old gstreamer X11 grab (the original stutter
# source). Universal fallback — used automatically if vkcapture-consumer or the
# host prereq is missing.
# export CLIP_CAPTURE_METHOD=ximagesrc
# export STEAM_LIBRARY=/mnt/game-streamer
# export CS2_DIR="$STEAM_LIBRARY/steamapps/common/Counter-Strike Global Offensive"
# export MEDIAMTX_SRT_BASE=srt://mediamtx.5stack.svc.cluster.local:8890

# --- Demo clip (highlight) smoothness ---------------------------------------
# The dominant clip stutter was a CAPTURE-induced render stall (ximagesrc's X11
# readback serializing with cs2's present) — fixed by the vkcapture present-hook
# above. The knobs below are secondary render tuning (all demo-only; live
# capture is untouched):
#
# Fixed timestep (clips, OFF by default — experimental): while a segment records, cs2
# runs host_framerate = clip fps (every frame is exactly one 1/fps game step), the
# vkcapture layer paces presents to exactly the clip fps, and frames are stamped by
# count. In production cs2 fell to ~25fps under it in a fight, so the game ran slow;
# stamps now never trail the clock by more than 250ms. 1 = on.
# export CLIP_FIXED_TIMESTEP=0
#
# Clip warm-up (on by default): before each segment, replay its range at 4x uncaptured,
# then wait (up to CLIP_WARMUP_SETTLE_MS, 12s) for cs2's CPU to fall under
# CLIP_WARMUP_SETTLE_CPU (400%) — its pipeline compiles draining. Ranges already warmed
# by this cs2 are skipped. CLIP_WARMUP_ONCE=1 warms only the first segment.
# export CLIP_WARMUP=1
#
# Grid pacing (clips, ON by default; 0 = off): the vkcapture layer paces cs2
# to exactly the clip fps on a fixed grid; a late frame skips the slots it missed
# instead of catching up, and the game clock is left alone. Fixes cs2's fps_max
# overshoot (63-64 presents/s into 60 slots = 3-4 dropped frames a second) without
# the fixed timestep's slow-motion risk; a render spike shows as a repeated frame.
# export CLIP_PACE=1
#
# Zero-copy capture (clips, OFF by default — no measured gain over the host-map copy): the vkcapture
# layer exports the shared image for a CUDA import and each frame is one GPU-to-GPU
# copy straight into the encoder (no PCIe readback, no CPU copy — the CPU copy costs
# ~30-50% of a capture core today). Falls back to the host-map copy by itself.
# export CLIP_ZEROCOPY=0
# AMD: zero-copy is a CUDA import, so AMD clips always take the host-map copy,
# whatever CLIP_ZEROCOPY says.
#
# Frame handoff (clips, ON by default; 0 = off): the vkcapture layer pokes the
# consumer only once a frame's GPU copy has landed and holds the next copy until the
# consumer has read it, so a read can't get the previous frame or a torn one.
# export CLIP_FRAME_HANDOFF=1
#
# Live / replay streams: the same grid pacing as clips on the cs2+HUD composite
# capture (LIVE_PACE, on by default). The frame handoff is opt-in there
# (LIVE_FRAME_HANDOFF=1) — it cost skipped frames during rounds on a replay stream.
# export LIVE_PACE=1
# export LIVE_FRAME_HANDOFF=0
#
# CPU split: capture gets the top CAPTURE_CORES (2); on streams, with at least
# GS_AUX_PIN_MIN_CORES (10) cores, the HUD and picom get AUX_CORES (1) below that; cs2
# gets the rest (spec-server stays unpinned: clip renders it starts need every core).
# CAPTURE_CPUS / AUX_CPUS / CS2_CPUS take explicit taskset lists; empty = don't pin that
# side. Setting AUX_CPUS by hand doesn't shrink CS2_CPUS — set both so they don't overlap.
# export AUX_CORES=1
#
# HUD drawing: 1 (default) = GPU; 0 = CPU. CPU drawing didn't reduce the skipped
# frames at camera switches on a replay stream.
# export HUD_GPU=1
#
# Clip final encode: h264_nvenc p6/hq at CLIP_FINAL_BITRATE (9M) VBR, peaks up to
# CLIP_FINAL_MAXRATE (14M) — about the old libx264 file size. CLIP_FINAL_ENCODER=x264
# forces the old libx264 veryfast crf 22 encode, also the fallback when NVENC fails.
# export CLIP_FINAL_BITRATE=9M
# export CLIP_FINAL_MAXRATE=14M
# AMD: the same CLIP_FINAL_* knobs, with CLIP_FINAL_BUFSIZE (18M), drive h264_vaapi
# after a one-frame trial; libx264 is the fallback, and CLIP_FINAL_ENCODER=x264 forces it.
#
# Render cap: clip batches default to 2x the clip rate while grid pacing (default on) or
# the fixed timestep is on, since the layer does the exact pacing; 1x with both off.
# Demo streaming defaults to 120. Set at launch (cs2 ignores a later fps_max).
# export CS2_FPS_MAX=60
#
# TrueView (cl_demo_predict): 0 = off (default — it made playback jitter and dropped
# the POV player's gunshots), 1 = only on a demo/client build match, 2 = always.
# export CS2_DEMO_PREDICT=0
#
# Debug overlay: 1 bakes cl_showfps + net_graph into the clip (off by default).
# export CS2_DEBUG_OVERLAY=1
#
# Capture diagnostics: per-second GPU/VRAM/clock + cs2/capture CPU into the
# render log (on by default; set 0 to mute).
# export CLIP_CAPTURE_DIAG=0
#
# NVIDIA's Vulkan shader disk cache is disabled for root unless
# __GL_SHADER_DISK_CACHE=1 is on the cs2 process, and Steam strips it — so
# setup-steam.sh injects it (plus OBS_VKCAPTURE=1) via cs2's launch options.
# Override the whole launch-option string here:
# export CS2_LAUNCH_OPTIONS="__GL_SHADER_DISK_CACHE=1 OBS_VKCAPTURE=1 %command%"
# AMD adds its own env in front of this string: VK_LOADER_DRIVERS_SELECT,
# MESA_VK_DEVICE_SELECT, MESA_VK_WSI_DEBUG when set, SDL_VIDEO_DRIVER=x11 and
# SDL_VIDEODRIVER=x11, then OBS_VKCAPTURE=1 for vkcapture when the string lacks it.
# A later word wins, so an override can change those values but not drop them.

# --- Vulkan shader pre-caching ---------------------------------------------
# NVIDIA only: GLCache and the __GL_* variables are NVIDIA driver settings. On AMD,
# Mesa keeps its shader cache where Steam puts it (steamapps/shadercache/730).
# Shaders always compile on launch so the persistent GLCache warms (first
# cold compile per GPU/driver is slow, later launches reuse it). Operators
# skip a compile per-match from the UI.
# export GL_SHADER_CACHE_DIR=/mnt/game-streamer/nvcache  # GLCache location
# export __GL_SHADER_DISK_CACHE_SIZE=10737418240         # 10 GiB cap
#
# DEBUG_STREAM=1 captures from boot (before Steam) so a boot hang is
# watchable via the "WATCH (HLS)" URL in the logs.
# export DEBUG_STREAM=1
# export DEBUG_STREAM_ID=debug      # publish path (default: MATCH_ID)

# --- AMD GPU (display and Vulkan) -------------------------------------------
# The api sets GS_GPU_VENDOR=amd and GS_GPU_PCI_ADDRESS (lowercase dddd:bb:dd.f) on
# AMD Jobs. A docker run on a host with one AMD GPU and no NVIDIA GPU finds the GPU
# by itself; on a host with two AMD GPUs, set the address by hand.
# export GS_GPU_PCI_ADDRESS=0000:03:00.0
#
# The pod limits the Vulkan loader to the AMD driver (VK_LOADER_DRIVERS_SELECT is
# '*radeon*'). '*' is the kill switch: it loads every driver again.
# export VK_LOADER_DRIVERS_SELECT='*'
# MESA_VK_DEVICE_SELECT and MESA_VK_WSI_DEBUG are set by the pod; preset them only
# for debugging. A preset MESA_VK_WSI_DEBUG without sw on an X server without DRI3
# gets a preflight WARN, and one that holds sw forces tier A.
#
# X runs on :20 or above on AMD (the pod scans :<base> to :<base+9>). A DISPLAY in
# the pod env is ignored there: set GS_X_DISPLAY_BASE instead, the same on every GPU
# pod of a node.
# export GS_X_DISPLAY_BASE=20
#
# GS_DISPLAY_TIER is A (the coexist Xorg) or C (weston plus Xwayland, with a
# self-test that falls back to A). The api passes it from GAME_STREAMER_DISPLAY_TIER;
# unset uses the image default (A). $LOG_DIR/display_tier holds the outcome and any
# fallback reason.
# export GS_DISPLAY_TIER=C
#
# On tier A the pod picks sw WSI by itself (MESA_VK_WSI_DEBUG=sw when X has no
# DRI3). GS_SW_WSI_FPS_MAX is the cs2 frame cap there for live and demo launches
# whose cap is 0, empty or higher; clip batches keep their launch cap.
# export GS_SW_WSI_FPS_MAX=120
# Never set CS2_FPS_MAX=0 on AMD: on tier C cs2 then runs unthrottled and loads a
# GPU that it may share with a desktop or other work.
#
# On AMD, GS_SKIP_GPU_PREFLIGHT=1 skips the vendor checks, their dies and vkcube,
# but never the DRI3 probe, the tier C self-test or the pod's Vulkan exports;
# $LOG_DIR/gpu_identity may then be missing.
# export GS_SKIP_GPU_PREFLIGHT=1
#
# AMD has no host prerequisite like nvidia-drm.modeset=1.
# GS_SYSFS_ROOT and GS_PROC_ROOT are for tests only.

# --- AMD GPU (encode) -------------------------------------------------------
# On AMD, live and clip capture encode with a VA-API element on the pod's render
# node (vah264enc, vah265enc or their varenderD<N> forms), after a one-frame trial
# at the output size. H.264 falls back to x264enc, and HEVC falls back to H.264.
# The ENCODER-CAPS log line and $LOG_DIR/encoder_caps show the pick and its reason.
# The GS_NVENC_* names are NVIDIA's, but on AMD the value va forces VA-API:
# export GS_NVENC_ELEMENT=va         # H.264; x264enc when VA-API is unusable
# export GS_NVENC_H265_ELEMENT=va    # HEVC; H.264 when VA-API is unusable
#
# GS_VA_TARGET_USAGE (1 to 7, default 4) maps to radeonsi presets: 1 is BALANCE plus
# pre-encode and VBAQ (more encoder work, so 1 is not the fast preset), 2 and 3 are
# BALANCE (the cheapest), 4 and 5 are QUALITY, and 6 and 7 clamp to QUALITY.
# export GS_VA_TARGET_USAGE=4
#
# GS_VA_RATE_CONTROL: vbr (default) or cbr for live streams. With cbr the encoder
# pads with filler data, which costs SRT bandwidth.
# export GS_VA_RATE_CONTROL=vbr
#
# GS_VA_H265_PCT: HEVC bitrate as a percent of the H.264 kbps (live and clips).
# The default is provisional until the quality check against NVENC.
# export GS_VA_H265_PCT=70
#
# GS_VA_FFMPEG_QP: the CQP value of the hevc_vaapi encode in inline clip renders.
# GS_VA_FFMPEG_LEVEL: the compression_level of both inline VA encodes; 5 is Mesa's
# QUALITY preset, with no pre-encode and no VBAQ. The inline h264_vaapi encode
# takes its bitrate from the CLIP_FINAL_* knobs above.
# Both defaults are provisional until the quality check against NVENC.
# export GS_VA_FFMPEG_QP=24
# export GS_VA_FFMPEG_LEVEL=5
#
# AMD_DEBUG goes to Mesa untouched. noefc (encoder format conversion off) is for
# A/B tests only.
# export AMD_DEBUG=noefc
#
# Encode support by GPU family (Mesa 25.2.8):
#   Strix Halo (gfx1151, VCN 4.0.6): H.264 and HEVC, AV1 off. Supported.
#   Other RDNA3 and RDNA3.5 APUs (Phoenix and Hawk Point, VCN 4.0.2; Strix Point and
#     Krackan, VCN 4.0.5): H.264 and HEVC. Experimental.
#   RDNA3 dGPUs (navi31 to navi33, VCN 4.0.0 and 4.0.4): experimental.
#   RDNA2 dGPUs and APUs (VCN 3.x; Van Gogh, Rembrandt, Mendocino, Raphael): H.264
#     and HEVC, no AV1. Experimental.
#   RDNA4 (gfx12*, VCN 5.0.0): H.264 always; HEVC only when the width and height,
#     each rounded up to a multiple of 16, are multiples of 64. 1920x1080 passes;
#     1280x720, 1600x900, 2560x1440 and 720x1280 use H.264 (reason rdna4-dpb-size).
#     Experimental.
#   Navi 24 (VCN 3.0.33, no encoder), VCN 4.0.3 and 5.0.1 (encode disabled in this
#     Mesa) and pre-VCN parts (VCE and UVD, tahiti to vega20) until soaked: allowed,
#     with a loud CPU x264 fallback; not recommended for streaming.
#   RDNA1 (navi10, navi12, navi14, VCN 2.0), Raven and Picasso (VCN 1.0), Renoir,
#     Cezanne and Barcelo (VCN 2.2, no EFC): untested; the trial decides.
#   AV1 stays off everywhere.

# --- Broadcast HUD ----------------------------------------------------------
# Stamped by the api; set by hand only when running a pod directly.
# export HUD_MODE=horizontal          # builtin layout the boot overlay opens: horizontal | vertical
# export HUD_ID=default               # JTs Hud Manager hud id of the chosen HUD
# export HUD_VARIANT=                 # layout within HUD_ID; empty for an imported HUD
# export HUD_SLUG=my-hud              # imported HUD only
# export HUD_BUNDLE_URL=https://...   # imported HUD only: presigned archive URL

# --- Nade lineup previews ---------------------------------------------------
# `game-streamer.sh nade-previews` connects to a practice server booted with
# UTILITY_RENDER_MODE (api stamps it) as a PLAYER and films one clip + four
# stills per lineup in NADE_BATCH_JOBS. Required: NADE_BATCH_JOBS,
# NADE_CONNECT_ADDR, NADE_CONNECT_PASSWORD.
#
# The plugin directs: the pod sends `say /render_stage <lineup id>` and
# `say /render_go`, then follows the plugin's [5stack-render] lines in
# console.log (staged, shot, still, act, thrown, detonated, done, error).
# export NADE_STAGE_TIMEOUT_MS=8000  # per render_stage attempt
# export NADE_PIN_PULL_MS=600        # +attack held before the release
# export NADE_MAX_CLIP_MS=45000      # go -> done backstop
# export NADE_KEEP_SNAPSHOTS=0       # 1 keeps the debug screen grab while filming
