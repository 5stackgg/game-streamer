# Copy to src/.env and fill in. Loaded automatically by game-streamer.sh.

# --- flow 1: setup-steam ---------------------------------------------------
export STEAM_USER=cs2_servers
export STEAM_PASSWORD=

# --- flow 2: run-live ------------------------------------------------------
export MATCH_ID=

# Pick ONE of these two pairs:
# export PLAYCAST_URL=
# - or -
export CONNECT_ADDR=
export CONNECT_PASSWORD=

# --- optional overrides ----------------------------------------------------
# export DEBUG_STREAM_ID=debug
# export FPS=30
# export VIDEO_KBPS=6000
# export STEAM_LIBRARY=/mnt/game-streamer
# export CS2_DIR="$STEAM_LIBRARY/steamapps/common/Counter-Strike Global Offensive"
# export MEDIAMTX_SRT_BASE=srt://mediamtx.5stack.svc.cluster.local:8890

# --- Vulkan shader pre-caching ---------------------------------------------
# SHADER_PRECACHE=1 lets Steam's "Processing Vulkan shaders" pass complete
# (instead of skipping it) so the persistent NVIDIA GLCache warms and the
# game/clips don't stutter. Defaults: OFF for live + demo (avoids a 5-13min
# cold-compile wait before a match), ON for batch-highlights. The first
# compile per (GPU, driver) is slow; later launches reuse the warm cache.
# export SHADER_PRECACHE=1
# export SHADER_PROGRESS=1          # surface compile % via status (default on)
# export SHADER_THREADS=8           # fossilize_replay forks (default: nproc)
# export POKE_SHADER_DIALOG=1       # force old behavior: skip the modal
# export EARLY_STREAM=0             # don't start the stream before cs2 (run-live)
# export DEBUG_STREAM=1             # start capture in setup-steam, the moment
#                                   # X is up (before Steam) — watch a boot hang
#                                   # live via the "WATCH (HLS)" URL in the logs
# export DEBUG_STREAM_ID=debug      # publish path for DEBUG_STREAM (default: MATCH_ID)
# export GL_SHADER_CACHE_DIR=/mnt/game-streamer/nvcache  # GLCache location
# export __GL_SHADER_DISK_CACHE_SIZE=10737418240         # 10 GiB cap
